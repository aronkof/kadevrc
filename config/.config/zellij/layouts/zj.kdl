layout {
  default_tab_template {
    children
    pane size=1 borderless=true {
      plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
        format_left  "{mode}#[fg=#89B4FA,bg=#181825,bold] KADEV :: #[bg=#181825] {tabs}"
        format_right "{command_kubectx}#[fg=#424554,bg=#181825]::{command_kubens}{datetime}"
        format_space "#[bg=#181825]"

        mode_normal          "#[bg=#89B4FA] "
        mode_tmux            "#[bg=#ffc387] "
        mode_default_to_mode "tmux"

        tab_normal               "#[fg=#6C7086,bg=#181825] {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
        tab_active               "#[fg=#FF4499,bg=#181825,bold,italic] {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
        tab_fullscreen_indicator "□ "
        tab_sync_indicator       "  "
        tab_floating_indicator   "󰉈 "

        command_kubectx_command  "kubectx -c"
        command_kubectx_format   "#[fg=#6C7086,bg=#181825,italic] {stdout}"
        command_kubectx_interval "2"

        command_kubens_command  "kubens -c"
        command_kubens_format   "#[fg=#6C7086,bg=#181825]{stdout} "
        command_kubens_interval "2"

        datetime          "#[fg=#9399B2,bg=#181825] {format} "
        datetime_format   "%A, %d %b %Y %H:%M"
        datetime_timezone "America/Sao_Paulo"
      }
    }
  }

  tab name="CODE" focus=true {
    pane
  }

  tab name="CLAUDE" {
    pane
  }

  tab name="CLI / REF" {
    pane
  }
}

