# VISUALS
theme = tokyonight
shell-integration-features = no-cursor,no-title
cursor-style-blink=false
cursor-style=block
# macos-titlebar-style = hidden
mouse-hide-while-typing = true
macos-non-native-fullscreen = visible-menu
window-padding-y = 15
window-padding-x = 10
window-padding-color = background
window-padding-balance = true
window-save-state = always
window-title-font-family="IosevkaTermSlab NFM"
font-family="IosevkaTermSlab NFM"
unfocused-split-opacity=.20

# KEYBOARD BEHAVIOR AND KEYBINDS
macos-option-as-alt = left
click-repeat-interval = 500
mouse-hide-while-typing = true

# ENABLE ZELLIJ/AEROSPACE BEHAVIOR
keybind = alt+left=unbind
keybind = alt+right=unbind

keybind = ctrl+m=unbind
keybind = ctrl+1=unbind
keybind = ctrl+2=unbind
keybind = ctrl+3=unbind
keybind = ctrl+4=unbind
keybind = ctrl+5=unbind

# PANE MOVEMENT
keybind = super+k=goto_split:up
keybind = super+j=goto_split:down
keybind = super+h=goto_split:left
keybind = super+l=goto_split:right

keybind = super+p=write_scrollback_file:open
